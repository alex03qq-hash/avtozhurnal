# Порт HTTP-сервера (в проде он же отдаёт собранный интерфейс)
PORT=4000

# Каталог с файлом базы данных приложения (db.json создаётся автоматически)
DATA_DIR=./data

# Интерфейс прослушивания: 0.0.0.0 — журнал доступен и с телефона в той же сети
HOST=0.0.0.0

# Код доступа к журналу (необязательно).
# Если задан, приложение требует этот код: на телефоне появляется экран входа.
# Только латинские буквы, цифры и знаки без пробелов, минимум 6 символов.
# Оставьте пустым, чтобы журнал открывался без кода.
ACCESS_TOKEN=garage-4821

# Режим работы: development | production
NODE_ENV=development
